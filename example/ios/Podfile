platform :ios, '16.0'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  config = File.join(__dir__, 'Flutter', 'Generated.xcconfig')
  File.foreach(config) do |line|
    match = line.match(/^FLUTTER_ROOT=(.*)$/)
    return match[1].strip if match
  end
  raise "FLUTTER_ROOT not found in #{config}"
end

require File.join(flutter_root, 'packages', 'flutter_tools', 'bin', 'podhelper')

flutter_ios_podfile_setup

target 'Runner' do
  flutter_install_all_ios_pods(__dir__)
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      version = config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"]
      if version && Gem::Version.new(version) < Gem::Version.new("16.0")
        config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "16.0"
      end
    end
  end
end
